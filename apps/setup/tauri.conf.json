{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Eventide Setup",
	"version": "../app-frontend/package.json",
	"identifier": "com.eventide.client.setup",
	"build": {
		"frontendDist": "ui"
	},
	"bundle": {
		"active": false,
		"icon": ["../app/icons/128x128.png", "../app/icons/icon.ico"]
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"label": "setup",
				"title": "Eventide Setup",
				"width": 860,
				"height": 540,
				"resizable": false,
				"maximizable": false,
				"decorations": false,
				"center": true,
				"visible": true
			}
		],
		"security": {
			"csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
		}
	}
}

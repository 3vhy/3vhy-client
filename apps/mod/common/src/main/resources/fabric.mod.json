{
	"schemaVersion": 1,
	"id": "eventide",
	"version": "${version}",
	"name": "Eventide",
	"description": "The in-game side of Eventide: HUD, crystal PvP tools, zoom, Discord presence and the Eventide game window.",
	"authors": ["Eventide"],
	"contact": {
		"homepage": "https://github.com/3vhy/Eventide",
		"sources": "https://github.com/3vhy/Eventide",
		"issues": "https://github.com/3vhy/Eventide/issues"
	},
	"license": "GPL-3.0-only",
	"icon": "assets/eventide/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["dev.eventide.client.EventideClient"]${gametest_entrypoint}
	},
	"mixins": ["eventide.mixins.json"],
	"depends": {
		"fabricloader": ">=0.18.0",
		"minecraft": "${minecraft_range}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	},
	"breaks": {
		"threevhy": "*"
	}
}
